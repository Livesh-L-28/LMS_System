{
  "name": "arvrweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx scripts/test-all-features.ts",
    "test:s3": "npx tsx scripts/test-s3-upload.ts",
    "test:security": "npx tsx scripts/test-security-hardening.ts",
    "audit": "npm audit --audit-level=high",
    "db:start": "npx tsx scripts/start-pg.ts",
    "db:stop": "./node_modules/@embedded-postgres/darwin-arm64/native/bin/pg_ctl stop -D .postgres-data -m fast",
    "db:status": "./node_modules/@embedded-postgres/darwin-arm64/native/bin/pg_ctl status -D .postgres-data",
    "s3:start": "npx tsx scripts/mock-s3.ts",
    "redis:start": "npx tsx scripts/mock-redis.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "@prisma/client": "^6.4.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "googleapis": "^176.0.0",
    "ioredis": "^6.0.0",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "prisma": "^6.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
