generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Student {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  registerNo    String             @unique
  contactNumber String
  email         String             @unique
  department    String
  year          String
  section       String
  batchId       String             @db.ObjectId
  pinHash       String
  createdAt     DateTime           @default(now())
  attendances   Attendance[]
  certificate   CertificateRecord?
  evaluations   Evaluation[]
  feedback      Feedback[]
  batch         Batch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  tasks         TaskSubmission[]

  @@index([batchId])
  @@index([department])
  @@index([section])
}

model Admin {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  email                String    @unique
  passwordHash         String
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  tempTwoFactorCode    String?
  tempTwoFactorExpires DateTime?
}

model Batch {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  name                String        @unique
  batchNo             String?
  level               String?       @default("Level 1")
  startDate           DateTime
  endDate             DateTime
  trainingDays        Int
  status              String        @default("ACTIVE")
  curriculumStatus    String?       @default("Not Set")
  googleDriveFolderId String?
  fnStartTime         String?       @default("08:30")
  fnCutoffTime        String?       @default("09:00")
  anStartTime         String?       @default("12:40")
  anCutoffTime        String?       @default("13:10")
  students            Student[]
  trainingCalendar    TrainingDay[]

  @@index([batchNo])
}

model TrainingDay {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  batchId         String           @db.ObjectId
  dayNumber       Int
  date            DateTime
  taskTitle       String
  taskDescription String
  tasks           Json?
  resources       Json?
  hasForenoon     Boolean          @default(true)
  hasAfternoon    Boolean          @default(true)
  submissions     TaskSubmission[]
  batch           Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, dayNumber])
  @@index([batchId])
  @@index([date])
}

model Attendance {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId String   @db.ObjectId
  date      DateTime
  session   String
  markedAt  DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, session])
  @@index([studentId])
  @@index([date])
}

model TaskSubmission {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  studentId           String      @db.ObjectId
  trainingDayId       String      @db.ObjectId
  screenshotUrl       String
  description         String?
  s3Key               String?
  s3Bucket            String?
  s3Region            String?
  storageProvider     String?     @default("GOOGLE_DRIVE")
  googleDriveFileId   String?
  googleDriveFolderId String?
  originalFilename    String?
  storedFilename      String?
  fileSize            Int?
  fileType            String?
  status              String      @default("SUBMITTED")
  submittedAt         DateTime    @default(now())
  evaluation          Evaluation?
  student             Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  trainingDay         TrainingDay @relation(fields: [trainingDayId], references: [id], onDelete: Cascade)

  @@unique([studentId, trainingDayId])
  @@index([studentId])
  @@index([trainingDayId])
  @@index([status])
  @@index([submittedAt])
  @@index([googleDriveFileId])
  @@index([s3Key])
}

model Evaluation {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId     String         @db.ObjectId
  taskId        String         @unique @db.ObjectId
  score         Int
  grade         String
  trainingLevel String
  comments      String?
  evaluatedAt   DateTime       @default(now())
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task          TaskSubmission @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([evaluatedAt])
}

model Feedback {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId String   @db.ObjectId
  message   String
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([createdAt])
}

model CertificateRecord {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId            String    @unique @db.ObjectId
  certificateNo        String    @unique
  finalGrade           String
  finalLevel           String
  completedAt          DateTime?
  exportedAt           DateTime?
  isValid              Boolean   @default(true)
  isManualOverride     Boolean   @default(false)
  overrideReason       String?
  attendancePctAtIssue Int?
  student              Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([completedAt])
}

model SystemSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model GoogleDriveConnection {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId               String?  @unique
  googleAccountEmail    String
  refreshTokenEncrypted String
  rootFolderId          String?
  connectedAt           DateTime @default(now())
  status                String   @default("CONNECTED")
  updatedAt             DateTime @updatedAt
}

model AuditLog {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId          String?
  actorEmail       String
  actorRole        String   @default("ADMIN")
  ipAddress        String?
  action           String
  targetType       String
  targetId         String?
  targetIdentifier String?
  details          String?
  createdAt        DateTime @default(now())

  @@index([actorEmail])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}
