# ==============================================================================
# AR/VR Spatial Computing Academy - Environment Configuration Template
# NOTE: Never commit real credentials or production secrets to source control.
# Copy this file to .env and fill in your values for local development.
# In production, inject these variables via Docker, Kubernetes Secrets, or AWS SSM.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 1. MongoDB Database Configuration (MongoDB Atlas Cluster / Replica Set)
# Format: mongodb+srv://[user]:[password]@[cluster].mongodb.net/[database]?retryWrites=true&w=majority
# Or Staging: mongodb+srv://[user]:[password]@[cluster].mongodb.net/lmssystem_staging?retryWrites=true&w=majority
# NOTE: Prisma transactions require a MongoDB Replica Set (Atlas clusters are replica sets by default)
# ------------------------------------------------------------------------------
DATABASE_URL="mongodb+srv://arvr_user:change_me_to_strong_db_password@cluster0.mongodb.net/lmssystem?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 2. Session Encryption Secret (iron-session)
# Must be at least 32 characters long. Use a cryptographically secure random string.
# Example generator: openssl rand -base64 32
# ------------------------------------------------------------------------------
SESSION_SECRET="replace_with_a_secure_random_string_at_least_32_characters_long"

# ------------------------------------------------------------------------------
# 3. Distributed Redis Cache & Rate Limiter
# Used for sliding-window rate limiting, brute-force lockout, and session revocation.
# ------------------------------------------------------------------------------
REDIS_URL="redis://redis:6379"

# ------------------------------------------------------------------------------
# 4. AWS S3 / Private Object Storage
# Stores student task submission screenshots, videos, and project files.
# For local dev / Docker Compose, MinIO is used on port 9000.
# For AWS production, omit AWS_S3_ENDPOINT to use AWS global S3 infrastructure.
# ------------------------------------------------------------------------------
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_or_minio_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_or_minio_secret_key"
AWS_S3_BUCKET_NAME="arvr-submissions-private"
AWS_S3_ENDPOINT="http://minio:9000"

# ------------------------------------------------------------------------------
# 5. Google Drive Integration (Optional Secondary Backup)
# Required for Google Drive backup export and trainer OAuth connectivity.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="https://academy.yourdomain.com/api/google-drive/oauth/callback"

# ------------------------------------------------------------------------------
# 6. Container & Migration Controls
# Set SKIP_MIGRATIONS=true if running in a horizontally scaled cluster
# where migrations are handled by a dedicated CI/CD job or Kubernetes InitContainer.
# ------------------------------------------------------------------------------
SKIP_MIGRATIONS=false
DB_WAIT_RETRIES=30
