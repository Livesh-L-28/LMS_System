@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
@import "tailwindcss";

:root {
  --background: #f4f3f8;
  --foreground: #0f172a;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
  --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

body {
  background-color: #f4f3f8;
  background-image: 
    radial-gradient(at 0% 0%, rgba(216, 180, 254, 0.35) 0px, transparent 50%),
    radial-gradient(at 100% 0%, rgba(192, 132, 252, 0.25) 0px, transparent 50%),
    radial-gradient(at 50% 100%, rgba(243, 232, 255, 0.8) 0px, transparent 50%);
  background-attachment: fixed;
  color: #0f172a;
  font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: #f4f3f8;
}
::-webkit-scrollbar-thumb {
  background: #d8b4fe;
  border-radius: 9999px;
}
::-webkit-scrollbar-thumb:hover {
  background: #c084fc;
}

/* Elevation Animations */
@keyframes pulseSubtle {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.animate-pulse-subtle {
  animation: pulseSubtle 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

/* Soft Lavender Card & Component Utilities */
.pro-card {
  background: #ffffff;
  border: 1px solid #e9d5ff;
  box-shadow: 0 10px 30px -5px rgba(147, 51, 234, 0.05), 0 2px 8px rgba(0, 0, 0, 0.02);
}

.pro-card-interactive {
  background: #ffffff;
  border: 1px solid #e9d5ff;
  box-shadow: 0 8px 24px -4px rgba(147, 51, 234, 0.06);
  transition: all 0.2s ease-in-out;
}
.pro-card-interactive:hover {
  border-color: #c084fc;
  transform: translateY(-2px);
  box-shadow: 0 14px 35px -5px rgba(147, 51, 234, 0.12), 0 0 15px 2px rgba(192, 132, 252, 0.15);
}

.pro-button-primary {
  background: linear-gradient(135deg, #b875ff 0%, #9333ea 100%);
  color: #ffffff;
  box-shadow: 0 4px 14px 0 rgba(147, 51, 234, 0.3);
  transition: all 0.2s ease-in-out;
}
.pro-button-primary:hover {
  background: linear-gradient(135deg, #aa63ff 0%, #7e22ce 100%);
  box-shadow: 0 6px 20px 0 rgba(147, 51, 234, 0.4);
  transform: translateY(-1px);
}
.pro-button-primary:active {
  transform: translateY(0);
}

.pro-input {
  background-color: #ffffff;
  border: 1px solid #d8b4fe;
  color: #0f172a;
  transition: all 0.15s ease-in-out;
}
.pro-input:focus {
  outline: none;
  border-color: #9333ea;
  box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.2);
}
